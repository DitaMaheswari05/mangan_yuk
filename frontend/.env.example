# Env Expo (FE). Hanya variabel EXPO_PUBLIC_* yang ikut ke bundle aplikasi, jadi isinya harus aman dipublikasikan.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_KEY=

# URL backend API (contoh: https://api.example.com/v1). Jika kosong, fallback ke http://localhost:3000/v1.
EXPO_PUBLIC_API_URL=

# Dev: pakai koordinat palsu di Sudirman Street Food (hapus/ubah ke 0 untuk GPS asli).
# Hanya berlaku di mode development; build rilis selalu memakai GPS asli.
EXPO_PUBLIC_MOCK_LOCATION=1
