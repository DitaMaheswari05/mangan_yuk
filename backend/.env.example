# Salin ke .env lalu isi. File .env tidak di-commit.
# Nilai lokal didapat dari output `npm run db:start` / `npx supabase status`.

# --- Supabase API (dipakai skrip export) ---
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Database (dipakai Prisma) ---
# Lokal: port 54322 (lihat supabase/config.toml), user/password default postgres/postgres.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Supabase hosted: ambil dari Dashboard → Connect. Ganti [PROJECT_REF], [PASSWORD], [REGION].
# DATABASE_URL lewat pooler mode transaction (6543) untuk query; DIRECT_URL lewat mode session (5432).
# SUPABASE_URL=https://[PROJECT_REF].supabase.co
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# DIRECT_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# --- Auth API (npm run dev) ---
PORT=3000
# Wajib, minimal 32 karakter. Buat dengan: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Isi jumlah proxy/load balancer di depan server supaya rate limit per IP memakai IP klien asli.
TRUST_PROXY=0
# Link di email reset password; token ditambahkan sebagai ?token=...
RESET_LINK_BASE=manganyuk://reset
